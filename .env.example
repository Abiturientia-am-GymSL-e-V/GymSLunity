APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DISPLAY_TIMEZONE=Europe/Berlin
# Compares the installed version with the GitHub releases (Configuration → System).
GYMSLUNITY_UPDATE_CHECK=true

# Passkeys/WebAuthn require HTTPS outside localhost. Keep this stable even
# when APP_KEY is rotated, otherwise existing passkeys become unusable.
PASSKEYS_USER_HANDLE_SECRET=
# PASSKEYS_RELYING_PARTY_ID=verein.example.org
# PASSKEYS_ALLOWED_ORIGINS=https://verein.example.org

# Behind a reverse proxy or load balancer: trusted proxy addresses (comma
# separated, or * for a managed load balancer), so rate limits see clients.
# TRUSTED_PROXIES=127.0.0.1

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_COOKIE=gymslunity_laravel_session
SESSION_DOMAIN=null
SECURITY_INACTIVITY_TIMEOUT=1800
SECURITY_AUDIT_RETENTION_DAYS=730
SECURITY_AUDIT_IDENTIFIER_RETENTION_DAYS=90
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Lokale Backups; für echte Ausfallsicherheit zusätzlich verschlüsselt extern kopieren.
BACKUP_PATH=storage/backups
BACKUP_RETENTION_DAYS=30

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# Für Redis CACHE_STORE, SESSION_DRIVER und/oder QUEUE_CONNECTION auf redis setzen.
# REDIS_URL=redis://user:password@127.0.0.1:6379
# REDIS_PREFIX=gymslunity_database_
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=90

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="GymSLunity"
