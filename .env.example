# GymSLunity – Umgebungskonfiguration
#
# Diese Vorlage enthält Werte für die lokale Entwicklung. Der Browser-Installer
# (/install) übernimmt sie als Grundlage und setzt die Produktionswerte selbst.
# Bei manueller Installation: nach .env kopieren und mindestens die mit
# [Produktion] markierten Werte anpassen. Alle Variablen beschreibt
# docs/konfiguration.md.

# --- Anwendung ---------------------------------------------------------------

# [Produktion] production. local nur für die Entwicklung.
APP_ENV=local
# Wird vom Installer bzw. von "php artisan key:generate" erzeugt. Bei einer
# bestehenden Installation niemals ändern: verschlüsselte Daten (z. B. IBANs)
# und signierte Backups wären sonst nicht mehr lesbar.
APP_KEY=
# [Produktion] false. true zeigt Fehlerdetails samt Konfiguration im Browser.
APP_DEBUG=true
# [Produktion] Öffentliche Adresse mit https://, ohne abschließenden Schrägstrich.
APP_URL=http://localhost:8000
# Zeitzone für Anzeige, Belegdatum und Nummernjahr.
APP_DISPLAY_TIMEZONE=Europe/Berlin
# Vergleicht die installierte Version mit den GitHub-Releases
# (Konfiguration → System). false schaltet die Abfrage ab.
GYMSLUNITY_UPDATE_CHECK=true

# --- Passkeys ----------------------------------------------------------------

# Passkeys/WebAuthn funktionieren außerhalb von localhost nur über HTTPS.
# Zufälliger Schlüssel (wie APP_KEY), vom Installer erzeugt. Muss dauerhaft
# gleich bleiben, auch wenn APP_KEY rotiert wird, sonst werden alle
# registrierten Passkeys unbrauchbar. Leer = aus APP_KEY abgeleitet.
PASSKEYS_USER_HANDLE_SECRET=
# Nur setzen, wenn Domain oder Origin von APP_URL abweichen.
# PASSKEYS_RELYING_PARTY_ID=verein.example.org
# PASSKEYS_ALLOWED_ORIGINS=https://verein.example.org

# --- Reverse Proxy -----------------------------------------------------------

# Hinter einem Reverse Proxy oder Load Balancer: dessen Adressen (durch Komma
# getrennt, * nur bei einem verwalteten Load Balancer). Sonst sehen
# Rate-Limits und Sicherheitsprotokoll nur die Adresse des Proxys.
# TRUSTED_PROXIES=127.0.0.1

# --- Sprache -----------------------------------------------------------------

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
# Nur für Testdaten (Factories/Seeder).
APP_FAKER_LOCALE=de_DE

# --- Wartungsmodus -----------------------------------------------------------

# file genügt für einen einzelnen Server. Bei mehreren Servern: cache und
# APP_MAINTENANCE_STORE auf einen gemeinsamen Cache setzen.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Anzahl paralleler Worker für "php artisan serve" (nur Entwicklung).
# PHP_CLI_SERVER_WORKERS=4

# --- Passwörter --------------------------------------------------------------

# Rechenaufwand für Passwort-Hashes. In Produktion mindestens 12.
BCRYPT_ROUNDS=12

# --- Protokollierung ---------------------------------------------------------

# Logs liegen unter storage/logs/. LOG_STACK=daily legt eine Datei pro Tag an.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# [Produktion] warning oder error. debug protokolliert sehr ausführlich.
LOG_LEVEL=debug

# --- Datenbank ---------------------------------------------------------------

# sqlite (Datei database/database.sqlite) oder mysql bzw. mariadb.
DB_CONNECTION=sqlite
# Für MariaDB/MySQL einkommentieren und ausfüllen:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# --- Sitzungen und Sicherheit ------------------------------------------------

# database ist Pflicht, damit Benutzer aktive Sitzungen einzeln widerrufen können.
SESSION_DRIVER=database
# Sitzungsdauer in Minuten. Darf SECURITY_INACTIVITY_TIMEOUT nicht überschreiten.
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
# [Produktion] true, damit das Sitzungscookie nur über HTTPS gesendet wird.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_COOKIE=gymslunity_laravel_session
SESSION_DOMAIN=null
# Automatische Abmeldung nach Inaktivität, in Sekunden.
SECURITY_INACTIVITY_TIMEOUT=1800
# Abstand in Sekunden, nach dem vor Exporten, Backups, Benutzerverwaltung und
# Mail-Einstellungen das Passwort erneut abgefragt wird.
# SECURITY_RECONFIRM_SECONDS=900
# Aufbewahrung von Sicherheitsereignissen und darin gespeicherten Kennungen
# (IP-Adressen, Browserkennungen), in Tagen.
SECURITY_AUDIT_RETENTION_DAYS=730
SECURITY_AUDIT_IDENTIFIER_RETENTION_DAYS=90
# Setzt Content-Security-Policy, HSTS und weitere Sicherheits-Header.
SECURITY_HEADERS_ENABLED=true
# HSTS-Dauer in Sekunden. Der Header wird in Produktion über HTTPS automatisch
# gesendet und gilt auch für Subdomains; 0 hebt HSTS auf.
SECURITY_HSTS_MAX_AGE=31536000

# --- Hintergrunddienste ------------------------------------------------------

BROADCAST_CONNECTION=log
# Speicherort für hochgeladene Dateien (storage/app/).
FILESYSTEM_DISK=local
# database oder redis erfordern einen dauerhaft laufenden Queue-Worker.
QUEUE_CONNECTION=database

# Cache für Rate-Limits und Einstellungen: database, file oder redis.
CACHE_STORE=database
# CACHE_PREFIX=

# --- Backups -----------------------------------------------------------------

# Lokale Backups; für echte Ausfallsicherheit zusätzlich verschlüsselt extern
# kopieren. Der Ordner darf nicht innerhalb von storage/app/ liegen.
BACKUP_PATH=storage/backups
BACKUP_RETENTION_DAYS=30

# --- Redis (optional) --------------------------------------------------------

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# Für Redis CACHE_STORE und/oder QUEUE_CONNECTION auf redis setzen.
# SESSION_DRIVER bleibt database.
# REDIS_URL=redis://user:password@127.0.0.1:6379
# REDIS_PREFIX=gymslunity_database_
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=90

# --- E-Mail ------------------------------------------------------------------

# Standard-Transport, solange unter Konfiguration → E-Mail-Versand nichts
# anderes eingestellt ist. log stellt keine E-Mails zu, sondern schreibt sie
# ins Log. Den Versand am besten dort in der Oberfläche einrichten.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="GymSLunity"

# --- Öffentliche Demo --------------------------------------------------------

# Nur für eine öffentliche Demo ohne echte Daten: zeigt die Zugangsdaten an und
# setzt jede Nacht alle Daten zurück (php artisan demo:reset).
DEMO_MODE=false
# DEMO_PASSWORD=Demo-Passwort-2026
# DEMO_RESET_AT=00:00
