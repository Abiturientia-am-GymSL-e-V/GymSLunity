APP_NAME=GymSLunity
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Portable default; requires pdo_sqlite. For MySQL use a NEW, dedicated
# database whose name ends in _testing, never the application database.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_URL=

BCRYPT_ROUNDS=4
CACHE_STORE=array
SESSION_DRIVER=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
