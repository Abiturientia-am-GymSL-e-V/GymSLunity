{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "gymslunity/mitgliedsverwaltung",
    "type": "project",
    "description": "GymSLunity – Mitgliederverwaltung mit Laravel, Vue und Inertia",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "EUPL-1.2",
    "require": {
        "php": "^8.4.1",
        "dompdf/dompdf": "^3.1",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/wayfinder": "^0.1.14",
        "phpoffice/phpspreadsheet": "^5.10",
        "phpoffice/phpword": "^1.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/chisel": "^0.1.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r '$env = file_get_contents(\".env\"); if (! preg_match(\"/^APP_KEY=.+$/m\", $env)) { passthru(PHP_BINARY.\" artisan key:generate --ansi\", $status); exit($status); }'",
            "npm ci",
            "npm run build",
            "@php artisan app:install --force --no-user"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run check",
            "npm run types:check",
            "@test",
            "@test:mariadb"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test"
        ],
        "test:mariadb": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv DB_CONNECTION=mariadb",
            "@putenv DB_HOST=127.0.0.1",
            "@putenv DB_PORT=3306",
            "@putenv DB_DATABASE=gymslunity_testing",
            "@putenv DB_USERNAME=gymslunity_testing",
            "@putenv DB_PASSWORD=testing",
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": [
                ]
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
